# Application Environment: "dev" or "production"
APP_ENV=dev
PORT=8080

# Database (PostgreSQL / Supabase)
# Local: postgresql://postgres:mypassword@db:5432/ticketin?sslmode=disable
# Supabase Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DB_URL="postgresql://postgres:mypassword@db:5432/ticketin?sslmode=disable"

# Redis (Local or Upstash)
# Local: redis:6379
# Upstash TLS: rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL="redis:6379"

# JWT Secret (generate a strong 32+ byte base64 key in production)
JWT_SECRET="xv6axE9vw9/VMVB/HsI8vmODnV6hfiCIvZfeeGFheuU="

# CORS: Comma-separated list of allowed frontend origins (e.g. Vercel)
CORS_ALLOWED_ORIGINS="http://localhost:5173,https://my-app.vercel.app"

# Email Provider: "smtp" (for Mailpit/SMTP) or "resend"
EMAIL_PROVIDER="smtp"
EMAIL_FROM="Ticketin <notifications@yourdomain.com>"

# Resend API Key (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=""

# SMTP Settings (when EMAIL_PROVIDER=smtp)
# Local Mailpit: mailpit:1025 (no auth needed)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
